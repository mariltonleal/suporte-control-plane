CONTROL_HOST=controle.suporte.krato.ai
CONTROL_ORIGIN=https://controle.suporte.krato.ai
GRAFANA_HOST=grafana.suporte.krato.ai
CONTROL_ADMIN_EMAIL=admin@example.com
CONTROL_ADMIN_PASSWORD=change-me
# SSO (Authentik). basic = usuario/senha acima. authentik = forward auth do Traefik; o painel valida o
# X-authentik-jwt com o client_secret do provider proxy (HS256) e nao usa mais a senha acima.
CONTROL_AUTH_MODE=basic
CONTROL_AUTHENTIK_JWT_SECRET=
CONTROL_AUTH_MIDDLEWARE=suporte-control-headers@docker
CONTROL_AUTH_OUTPOST_SERVICE=suporte-control@docker
AUTHENTIK_URL=https://auth.krato.ai
CONTROL_MASTER_KEY=GENERATE_FERNET_KEY
CONTROL_DB_PASSWORD=GENERATE_STRONG_PASSWORD

PORTAINER_URL=https://portainer.example.com
PORTAINER_API_KEY=ptr_xxxxxxxxx
PORTAINER_ENDPOINT_ID=1
# Portainer 2.43+: id da Source Git (GET /api/gitops/sources). Com Source, o PAT fica so no Portainer.
PORTAINER_SOURCE_ID=0
PORTAINER_GIT_CREDENTIAL_ID=0

# LEGADO: este arquivo é histórico. Produção usa suporte-remoto/.env.control-plane.example
SUPPORT_REPO_URL=https://github.com/mariltonleal/suporte-remoto
SUPPORT_REPO_REF=refs/heads/main
SUPPORT_COMPOSE_FILE=compose.tenant.yaml
SUPPORT_GIT_USERNAME=
SUPPORT_GIT_TOKEN=

BASE_DOMAIN=suporte.krato.ai
PROXY_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

SHARED_TURN_HOST=turn.krato.ai
SHARED_TURN_SECRET=USE_THE_SHARED_TURN_SECRET
METRICS_TOKEN=GENERATE_ONE_SHARED_METRICS_TOKEN
# node-exporter escuta na rede do host (porta 9101) com basic auth. Hash bcrypt do mesmo valor, em base64
# (o hash tem `$` e o Compose/Portainer interpolam `$x` dentro dos valores do env-file):
#   docker run --rm httpd:2.4-alpine htpasswd -nbB prometheus "$NODE_EXPORTER_PASSWORD" | cut -d: -f2 | tr -d '\n' | base64 -w0
NODE_EXPORTER_PORT=9101
NODE_EXPORTER_PASSWORD=GENERATE_STRONG_PASSWORD
NODE_EXPORTER_PASSWORD_HASH_B64=BASE64_OF_THE_BCRYPT_HASH

# Sub-redes: control plane usa CONTROL_SUBNET; cada cliente recebe TENANT_SUBNET_PREFIX.<1-250>.0/24
CONTROL_SUBNET=10.88.0.0/24
TENANT_SUBNET_PREFIX=10.88
PROMETHEUS_RETENTION=30d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Grafana com OIDC do Authentik (provider oauth-suporte-grafana): true + client id/secret.
GRAFANA_OAUTH_ENABLED=false
# true = sem formulario local: abrir o Grafana ja leva ao Authentik (admin local so em /login?disableAutoLogin=true)
GRAFANA_OAUTH_AUTO_LOGIN=false
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_CLIENT_SECRET=
GRAFANA_OAUTH_APP_SLUG=suporte-grafana
GRAFANA_OAUTH_ADMIN_GROUP=suporte-grafana-admin
GRAFANA_OAUTH_VIEWER_GROUP=suporte-grafana
