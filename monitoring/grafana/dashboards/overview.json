  {
   "type": "stat",
   "title": "Erros HTTP 5xx (1h)",
   "id": 7,
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(increase(support_http_5xx_total{tenant=~\"$tenant\"}[1h]))",
     "legendFormat": "5xx",
     "refId": "A"
    }
   ],
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   }
  },
